# ======================
# Telegram
# ======================
TELEGRAM_TOKEN=1234567890:AAExampleTelegramBotToken

# ======================
# Database (PostgreSQL)
# ======================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_bot

# ======================
# Ollama
# ======================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ======================
# Application
# ======================
LOG_LEVEL=INFO
SESSION_TTL_HOURS=24
CONTEXT_MESSAGES_LIMIT=10

# ======================
# Network / Timeouts
# ======================
LLM_TIMEOUT=60
HTTP_TIMEOUT=30
